{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vusolutions",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  // Static site from dist/ (produced by `npm run build`, see scripts/prerender.mjs).
  // The Worker script only runs for /api/*; every other path is served straight from assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vusolutions-db",
      "database_id": "5123d241-5bd7-46e7-afa2-930bbd050c87",
      // Not "migrations": that collides with the EF Core Migrations/ folder on case-insensitive filesystems
      "migrations_dir": "d1-migrations"
    }
  ],
  // Email Routing send binding; free on all plans because it only sends to a verified destination
  "send_email": [
    { "name": "EMAIL", "destination_address": "vohoanvu96@gmail.com" }
  ],
  "vars": {
    "CONTACT_FROM": "contact@vusolutions.net",
    "CONTACT_TO": "vohoanvu96@gmail.com",
    // Production hostnames accepted from Turnstile siteverify; .dev.vars overrides this locally
    "TURNSTILE_HOSTNAMES": "vusolutions.net,www.vusolutions.net"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "vusolutions.net", "custom_domain": true },
    { "pattern": "www.vusolutions.net", "custom_domain": true }
  ]
}
