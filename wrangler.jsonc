{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vusolutions",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  // Static site from dist/ (produced by `npm run build`, see scripts/prerender.mjs).
  // The Worker script only runs for /api/* and the resume PDF (served from KV); everything else is assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/files/Vu-Resume-Latest.pdf"]
  },
  // Uploaded resume PDF + last 5 versions (src/resume.js). Falls back to the bundled PDF when empty.
  "kv_namespaces": [
    { "binding": "RESUME", "id": "cca697a6fcab4e019c56a547b1e0ffc5" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vusolutions-db",
      "database_id": "5123d241-5bd7-46e7-afa2-930bbd050c87",
      // Not "migrations": that collides with the EF Core Migrations/ folder on case-insensitive filesystems
      "migrations_dir": "d1-migrations"
    }
  ],
  // Email Routing send binding; free on all plans because it only sends to a verified destination
  "send_email": [
    { "name": "EMAIL", "destination_address": "vohoanvu96@gmail.com" }
  ],
  "vars": {
    "CONTACT_FROM": "contact@vusolutions.net",
    "CONTACT_TO": "vohoanvu96@gmail.com",
    // Production hostnames accepted from Turnstile siteverify; .dev.vars overrides this locally
    "TURNSTILE_HOSTNAMES": "vusolutions.net,www.vusolutions.net",
    // Supabase Auth project whose access tokens unlock /api/admin/* (src/auth.js). Fails closed while empty.
    "SUPABASE_URL": "https://ebrdrsqcrjyvufgkcznw.supabase.co",
    "ADMIN_EMAILS": "vohoanvu96@gmail.com"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "vusolutions.net", "custom_domain": true },
    { "pattern": "www.vusolutions.net", "custom_domain": true }
  ]
}
