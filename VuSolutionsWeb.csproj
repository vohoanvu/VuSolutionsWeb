<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- .NET 9+ publish writes .gz/.br copies of every static file; Cloudflare compresses at the edge, so keep them out of dist/ -->
    <CompressionEnabled>false</CompressionEnabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Cloudflare static build tooling, not part of the ASP.NET app -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;dist/**;.build/**;.wrangler/**;src/**;d1-migrations/**;package*.json;wrangler.jsonc</DefaultItemExcludes>
  </PropertyGroup>

</Project>
