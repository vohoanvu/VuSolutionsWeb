@{
    var description = ViewData["Description"] as string
        ?? "VU Solutions: software products and agentic AI workflows by Vo Hoan Vu, a .NET and React developer based in Vietnam.";
    var title = ViewData["Title"] is string pageTitle ? $"{pageTitle} | VU Solutions" : "VU Solutions";
    var path = Context.Request.Path.Value ?? "/";
    var canonical = $"https://vusolutions.net{path}";
    string? Current(string href) => string.Equals(path, href, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="author" content="Vo Hoan Vu" />
    <meta name="theme-color" content="#1E1C19" />
    <link rel="canonical" href="@canonical" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VU Solutions" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="https://vusolutions.net/images/og-preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="https://vusolutions.net/images/og-preview.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Noto+Sans:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="navbar">
        <nav class="container navbar__inner" aria-label="Main">
            <a class="navbar__brand" href="/">VU <span>·</span> Solutions</a>
            <button class="navbar__toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation">
                @Icons.Svg("menu", 20, "icon-open")
                @Icons.Svg("x", 20, "icon-close")
            </button>
            <ul class="navbar__links" id="nav-links">
                <li><a class="navbar__link" href="/Home/Portfolio" aria-current="@Current("/Home/Portfolio")">Portfolio</a></li>
                <li><a class="navbar__link" href="/#services">Services</a></li>
                <li><a class="navbar__link" href="/files/Vu-Resume-Latest.pdf" target="_blank" rel="noopener">Resume</a></li>
                <li><a class="navbar__link" href="/#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer__inner">
            <div>
                <p class="footer__brand">VU Solutions LLC</p>
                <p class="footer__details">
                    <span>@Icons.Svg("building-2", 14) Tax number: 0402259203</span>
                    <span>@Icons.Svg("map-pin", 14) 60 Nguyen Du, Hai Chau, Da Nang, Vietnam</span>
                    <span>&copy; @DateTime.UtcNow.Year VU Solutions LLC</span>
                </p>
            </div>
            <ul class="footer__links">
                <li><a href="/Home/Portfolio">Portfolio</a></li>
                <li><a href="https://github.com/vohoanvu" target="_blank" rel="noopener">GitHub</a></li>
                <li><a href="https://www.linkedin.com/in/thevuture/" target="_blank" rel="noopener">LinkedIn</a></li>
                <li><a href="/Privacy">Privacy</a></li>
            </ul>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
