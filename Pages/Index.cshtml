@page
@model IndexModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Software products & agentic AI workflows";
    ViewData["Description"] = "Vo Hoan Vu builds SaaS products in .NET, React and the cloud, and designs agentic AI workflows that hold up in production. Founder of VU Solutions, based in Vietnam.";
    var turnstileSiteKey = Configuration["Turnstile:SiteKey"];
}

<section class="hero">
    <div class="container hero__inner">
        <div class="fade-up">
            <p class="eyebrow">VU Solutions · Software &amp; AI engineering · Vietnam</p>
            <h1 class="hero__title">I build software products, and the AI agents that help run them.</h1>
            <p class="hero__subtitle">
                I'm Vu, a software developer and the founder of VU Solutions. I've shipped .NET and React products
                for fintech, pharma, racing and childcare clients since 2019. These days I also design agentic AI
                workflows, and I use them to run my own work.
            </p>
            <div class="hero__actions">
                <a class="btn btn--cta btn--lg" href="#contact">Start a conversation</a>
                <a class="btn btn--ghost-dark btn--lg" href="/Home/Portfolio">See my work @Icons.Svg("arrow-right", 16)</a>
            </div>
            <ul class="hero__links">
                <li><a href="/files/Vu-Resume-Latest.pdf" target="_blank" rel="noopener">@Icons.Svg("file-text", 16) Resume</a></li>
                <li><a href="https://github.com/vohoanvu" target="_blank" rel="noopener">@Icons.Svg("github", 16) GitHub</a></li>
                <li><a href="https://www.linkedin.com/in/thevuture/" target="_blank" rel="noopener">@Icons.Svg("linkedin", 16) LinkedIn</a></li>
            </ul>
        </div>
        <figure class="hero__portrait fade-up fade-up--2">
            <img src="~/images/vu-portrait.webp" alt="Vo Hoan Vu" width="408" height="612" fetchpriority="high" />
            <figcaption>Vo Hoan Vu · Founder</figcaption>
        </figure>
    </div>
</section>

<section class="section" aria-labelledby="now-title">
    <div class="container">
        <header class="section-header">
            <p class="eyebrow">01 · Right now</p>
            <h2 class="section-header__title" id="now-title">What I'm working on</h2>
            <p class="section-header__description">
                VU Solutions is my registered single-member company. Client work, a startup and my own product all
                run through it.
            </p>
        </header>
        <div class="grid grid--3">
            <article class="card">
                <span class="card__icon">@Icons.Svg("briefcase", 20)</span>
                <p class="card__meta">Client work · Remote</p>
                <h3 class="card__title">Developer for OWNA</h3>
                <div class="card__body">
                    <p>
                        I work as a remote developer for OWNA, an Australian SaaS company serving the childcare
                        sector, contracting through VU Solutions.
                    </p>
                </div>
                <div class="card__footer">
                    <span class="badge badge--blue">Childcare SaaS</span>
                    <span class="badge badge--parch">Australia</span>
                </div>
            </article>
            <article class="card">
                <span class="card__icon">@Icons.Svg("building-2", 20)</span>
                <p class="card__meta">Startup · CTO</p>
                <h3 class="card__title">CTO of TKNQ</h3>
                <div class="card__body">
                    <p>
                        TKNQ is an early-stage Australian startup building all-in-one software for Brazilian Jiu-Jitsu
                        gyms. I own the technical side: architecture, AI research and delivery.
                    </p>
                </div>
                <div class="card__footer">
                    <a class="link-arrow" href="https://tknq.io" target="_blank" rel="noopener">tknq.io @Icons.Svg("arrow-up-right", 14)</a>
                </div>
            </article>
            <article class="card">
                <span class="card__icon">@Icons.Svg("sparkles", 20)</span>
                <p class="card__meta">My product · Live demo</p>
                <h3 class="card__title">CodeJitsu</h3>
                <div class="card__body">
                    <p>
                        An AI coach that watches BJJ sparring footage and turns it into a timestamped breakdown, a grade
                        and the drills that fix what went wrong. It's also TKNQ's R&amp;D testbed.
                    </p>
                </div>
                <div class="card__footer">
                    <a class="link-arrow" href="/Home/Portfolio#codejitsu">Read the case study @Icons.Svg("arrow-right", 14)</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section section--surface" id="services" aria-labelledby="services-title">
    <div class="container">
        <header class="section-header">
            <p class="eyebrow">02 · Services</p>
            <h2 class="section-header__title" id="services-title">What I can do for you</h2>
        </header>
        <div class="grid grid--3">
            <article class="card">
                <span class="card__icon">@Icons.Svg("code-xml", 20)</span>
                <h3 class="card__title">Product engineering</h3>
                <div class="card__body">
                    <p>
                        Web products from the first prototype to production: ASP.NET Core and C#, React and TypeScript,
                        PostgreSQL, Google Cloud and Cloudflare. I take features end to end, from database migration
                        to deployed and monitored.
                    </p>
                </div>
            </article>
            <article class="card">
                <span class="card__icon">@Icons.Svg("workflow", 20)</span>
                <h3 class="card__title">Agentic AI workflows</h3>
                <div class="card__body">
                    <p>
                        I design, orchestrate and evaluate multi-step AI pipelines. That means splitting a job into
                        focused agents, adding verification passes, capping cost and keeping a person in the loop.
                    </p>
                    <p>
                        I run my own development team of AI agents, and my company's bookkeeping and tax workflow runs
                        on MISA with AI assistance. I've seen where agents break, not just where they shine.
                    </p>
                </div>
            </article>
            <article class="card">
                <span class="card__icon">@Icons.Svg("users", 20)</span>
                <h3 class="card__title">Technical leadership</h3>
                <div class="card__body">
                    <p>
                        For an early-stage team that needs a CTO's judgment before it can hire one: architecture,
                        delivery plans, cloud operations and cost control. That's my role at TKNQ today.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="approach-title">
    <div class="container">
        <header class="section-header">
            <p class="eyebrow">03 · How I work</p>
            <h2 class="section-header__title" id="approach-title">Straight answers, both ways</h2>
        </header>
        <div class="grid grid--2">
            <div class="scroll-card">
                <h3 class="scroll-card__title">Tell me what went wrong</h3>
                <div class="scroll-card__body">
                    <p>
                        I'll tell you plainly when an idea, an estimate or a line of code is wrong, including my own.
                        I ask for the same in return. If something I shipped missed the mark, say so directly. Problems
                        found early are cheap; problems softened into politeness are expensive.
                    </p>
                </div>
            </div>
            <div class="scroll-card">
                <h3 class="scroll-card__title">Principles I build by</h3>
                <div class="scroll-card__body">
                    <ul>
                        <li><strong>Small steps you can verify.</strong> I break work into pieces that can each be checked by a test, a review pass or a person.</li>
                        <li><strong>AI only where it earns its place.</strong> I've replaced an AI feature with a plain API call when that was faster, cheaper and more reliable.</li>
                        <li><strong>Cost and failure are part of the feature.</strong> Quotas, refunds and retries belong in version one, not after the first surprise bill.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section--tight" aria-labelledby="work-title">
    <div class="container">
        <header class="section-header">
            <p class="eyebrow">04 · Selected work</p>
            <h2 class="section-header__title" id="work-title">Products I built and run myself</h2>
        </header>
        <div class="grid grid--2">
            <article class="card card--interactive">
                <div class="card__media">
                    <img src="~/images/portfolio/codejitsu-card.webp" alt="CodeJitsu landing page: &quot;AI that reads a BJJ sparring tape&quot;" width="662" height="372" loading="lazy" />
                </div>
                <h3 class="card__title">CodeJitsu: an AI coach for BJJ sparring footage</h3>
                <div class="card__body">
                    <p>Upload a sparring video and Gemini returns a timestamped breakdown, a grade and the drills to work on, then drafts the next class plan. Built with a team of five AI agents.</p>
                </div>
                <div class="card__footer">
                    <a class="link-arrow" href="/Home/Portfolio#codejitsu">Case study @Icons.Svg("arrow-right", 14)</a>
                </div>
            </article>
            <article class="card card--interactive">
                <div class="card__media card__media--panel" aria-hidden="true">
                    <p class="search-mock__prompt">What would Joe Rogan say about…?</p>
                    <div class="search-mock__field">@Icons.Svg("sparkles", 16) <span>e.g. Jiu Jitsu, Bears, Bees, Aliens</span></div>
                </div>
                <p class="card__meta">Semantic search · Embeddings</p>
                <h3 class="card__title">JRE Clipper: "What would Joe Rogan say?"</h3>
                <div class="card__body">
                    <p>
                        Ask about any topic and get the exact moments it came up across the Joe Rogan Experience
                        archive. Transcripts are turned into embeddings, so search works by meaning, and every result jumps
                        straight to the moment it was said.
                    </p>
                </div>
                <ul class="badge-list">
                    <li class="badge badge--parch">Data embeddings</li>
                    <li class="badge badge--parch">Semantic search</li>
                    <li class="badge badge--parch">Vertex AI</li>
                </ul>
                <div class="card__footer">
                    <a class="link-arrow" href="/Home/Portfolio#jre-clipper">How it works @Icons.Svg("arrow-right", 14)</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section section--surface" id="contact" aria-labelledby="contact-title">
    <div class="container">
        <header class="section-header">
            <p class="eyebrow">05 · Contact</p>
            <h2 class="section-header__title" id="contact-title">Tell me what you're building</h2>
            <p class="section-header__description">
                A product to build, an AI workflow that isn't working, or a team that needs technical leadership.
                Every message comes straight to me.
            </p>
        </header>

        <div class="contact">
            <form class="form card" id="contact-form" action="/api/contact" method="post" novalidate>
                <div class="form__row">
                    <div class="field">
                        <label class="field__label" for="contact-name">Name</label>
                        <input class="field__input" id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" aria-describedby="contact-name-error" />
                        <p class="field__error" id="contact-name-error"></p>
                    </div>
                    <div class="field">
                        <label class="field__label" for="contact-email">Email</label>
                        <input class="field__input" id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="contact-email-error" />
                        <p class="field__error" id="contact-email-error"></p>
                    </div>
                </div>
                <div class="field">
                    <label class="field__label" for="contact-phone">Phone <span class="optional">(optional)</span></label>
                    <input class="field__input" id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" aria-describedby="contact-phone-error" />
                    <p class="field__error" id="contact-phone-error"></p>
                </div>
                <div class="field">
                    <label class="field__label" for="contact-message">Message</label>
                    <textarea class="field__input" id="contact-message" name="message" required minlength="10" maxlength="5000" placeholder="What are you building, and where are you stuck?" aria-describedby="contact-message-error"></textarea>
                    <p class="field__error" id="contact-message-error"></p>
                </div>

                <div class="turnstile-slot" id="contact-turnstile"></div>

                <div class="form-status" id="contact-status" role="status" aria-live="polite"></div>

                <div class="form__footer">
                    <p class="form__note">Protected by Cloudflare Turnstile. See the <a href="/Privacy">privacy policy</a> for how your message is stored.</p>
                    <button class="btn btn--dark btn--lg" type="submit" id="contact-submit">
                        @Icons.Svg("send", 16) <span>Send message</span>
                    </button>
                </div>
            </form>

            <aside aria-label="Other ways to reach me">
                <ul class="contact-list">
                    <li>
                        @Icons.Svg("mail", 16)
                        <div><strong>Email</strong><a href="mailto:vohoanvu96@gmail.com">vohoanvu96@gmail.com</a></div>
                    </li>
                    <li>
                        @Icons.Svg("file-text", 16)
                        <div><strong>Resume</strong><a href="/files/Vu-Resume-Latest.pdf" target="_blank" rel="noopener">Download PDF</a></div>
                    </li>
                    <li>
                        @Icons.Svg("linkedin", 16)
                        <div><strong>LinkedIn</strong><a href="https://www.linkedin.com/in/thevuture/" target="_blank" rel="noopener">in/thevuture</a></div>
                    </li>
                    <li>
                        @Icons.Svg("github", 16)
                        <div><strong>GitHub</strong><a href="https://github.com/vohoanvu" target="_blank" rel="noopener">vohoanvu</a></div>
                    </li>
                    <li>
                        @Icons.Svg("map-pin", 16)
                        <div><strong>Location</strong>Vietnam (UTC+7). Working remotely with teams in Australia and beyond.</div>
                    </li>
                </ul>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("contact-form");
            const submit = document.getElementById("contact-submit");
            const status = document.getElementById("contact-status");
            const sitekey = "@turnstileSiteKey";
            let widgetId;

            window.onContactTurnstileLoad = function () {
                const slot = document.getElementById("contact-turnstile");
                // The normal widget is a fixed 300px wide; use the compact one on narrow phones
                const size = slot.clientWidth < 300 ? "compact" : "normal";
                widgetId = window.turnstile.render(slot, { sitekey, action: "contact", theme: "light", size });
            };

            const showStatus = (kind, message) => {
                status.className = `form-status form-status--${kind} is-visible`;
                status.textContent = message;
            };

            const setFieldErrors = (errors) => {
                for (const name of ["name", "email", "phone", "message"]) {
                    const input = form.elements[name];
                    const error = document.getElementById(`contact-${name}-error`);
                    const message = errors[name] || "";
                    error.textContent = message;
                    input.setAttribute("aria-invalid", message ? "true" : "false");
                }
            };

            const clientErrors = () => {
                const errors = {};
                const value = (name) => form.elements[name].value.trim();
                if (value("name").length < 2) errors.name = "Please enter your name.";
                if (!form.elements.email.checkValidity() || !value("email")) errors.email = "Please enter a valid email address.";
                if (value("message").length < 10) errors.message = "Please write a message (at least 10 characters).";
                return errors;
            };

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                status.className = "form-status";

                const errors = clientErrors();
                setFieldErrors(errors);
                if (Object.keys(errors).length > 0) {
                    form.elements[Object.keys(errors)[0]].focus();
                    return;
                }

                const data = new FormData(form);
                if (!data.get("cf-turnstile-response")) {
                    showStatus("error", "Please complete the verification check above the button.");
                    return;
                }

                submit.disabled = true;
                try {
                    const response = await fetch(form.action, { method: "POST", body: data });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || result.ok !== true) {
                        if (result.errors) setFieldErrors(result.errors);
                        throw new Error(result.error || "Something went wrong. Please try again, or email me directly.");
                    }
                    form.reset();
                    setFieldErrors({});
                    showStatus("success", "Thanks, your message is on its way. I'll get back to you by email.");
                } catch (err) {
                    showStatus("error", err.message);
                } finally {
                    submit.disabled = false;
                    // Turnstile tokens are single-use
                    if (widgetId !== undefined) window.turnstile.reset(widgetId);
                }
            });
        })();
    </script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onContactTurnstileLoad&render=explicit" async defer></script>
