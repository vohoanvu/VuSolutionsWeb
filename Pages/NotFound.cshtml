@page
@* Prerendered to 404.html and served by Cloudflare for unknown paths *@
@{
    ViewData["Title"] = "Page not found";
}

<section class="hero hero--compact">
    <div class="container hero__inner">
        <div>
            <p class="eyebrow">404</p>
            <h1 class="hero__title">This page doesn't exist</h1>
            <p class="hero__subtitle">The link may be old, or the address may have a typo. Page addresses here are case-sensitive.</p>
            <div class="hero__actions">
                <a class="btn btn--cta btn--lg" href="/">Back to home</a>
                <a class="btn btn--ghost-dark btn--lg" href="/Home/Portfolio">See the portfolio</a>
            </div>
        </div>
    </div>
</section>
